TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_PATH=referrals.db
VALIDATION_TIMEOUT_SECONDS=10
VALIDATION_RETRIES=2
URL_WATCH_INTERVAL_SECONDS=30

# Threads is optional. Leave blank while unavailable.
THREADS_ACCESS_TOKEN=
THREADS_WATCH_INTERVAL_SECONDS=30
THREADS_SEARCH_LIMIT=50
THREADS_QUERIES=claude.ai/referral,claude referral

# X API app-only bearer token.
X_BEARER_TOKEN=
# Recent search is diagnostics/backfill only. Separate multiple queries with ||.
X_QUERIES=url:"claude.ai/referral"
X_SEARCH_LIMIT=100
# Production/live X monitoring. Separate multiple rules with ||.
X_STREAM_RULES=url:"claude.ai/referral"
X_STREAM_RECONNECT_SECONDS=5

# Reddit Data API OAuth. Reddit approval is required for API access.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:referral-monitor:v0.6 (by u/YOUR_REDDIT_USERNAME)
REDDIT_WATCH_INTERVAL_SECONDS=20
REDDIT_SEARCH_LIMIT=100
# Separate multiple search queries with ||.
REDDIT_QUERIES=claude.ai/referral||"Claude referral"||"Claude guest pass"
