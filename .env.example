TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Only these private/group chat IDs may rotate the Apify token.
TELEGRAM_ADMIN_CHAT_IDS=
DATABASE_PATH=referrals.db
VALIDATION_TIMEOUT_SECONDS=10
VALIDATION_RETRIES=2
# Claude validation calls are serialized and spaced to avoid bursts/HTTP 429.
VALIDATION_MIN_GAP_SECONDS=1.0
# Optional clean HTTP/HTTPS proxy used only when the direct JSON API returns 403.
# Example format: http://username:password@host:port
VALIDATOR_PROXY_URL=
VALIDATION_QUEUE_POLL_SECONDS=2
VALIDATION_QUEUE_WORKERS=3
VALIDATION_MAX_ATTEMPTS=1
VALIDATION_RETRY_BASE_SECONDS=5
VALIDATION_RETRY_MAX_SECONDS=120
TELEGRAM_RETRY_BASE_SECONDS=5
TELEGRAM_RETRY_MAX_SECONDS=300
TELEGRAM_FEEDBACK_POLL_SECONDS=5
URL_WATCH_INTERVAL_SECONDS=30

# Scrape Creators is used for Threads + Reddit. Put the real key only in your
# local .env / Render secret.
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_TIMEOUT_SECONDS=30

# Global discovery target. This is what every result is STRICTLY filtered on
# before anything reaches Telegram.
REFERRAL_SEARCH_TERM=claude.ai/referral
# false = one query per source/poll (budget baseline). true = also run extra keyword queries.
SEARCH_INCLUDE_BROAD_KEYWORDS=false
# How many raw provider rows to log in full per poll. Rows that DO contain a
# referral link but get rejected are always logged in full regardless of this.
SOURCE_DIAGNOSTIC_SAMPLES=3

# NOTE on queries: retrieval and filtering are separate steps.
# Threads / Instagram / Facebook search engines cannot match a literal URL, so
# they are queried with keywords and the results are then strictly filtered for
# claude.ai/referral/. Reddit's search does index link targets, so it keeps the
# URL query. Leave these unset to use the defaults below.
#
# NOTE on *_LOOKBACK_MINUTES vs *_MAX_POST_AGE_MINUTES:
#   LOOKBACK  = how far back we ASK the provider for, aligned to the poll interval.
#   MAX_POST_AGE = how old a post carrying a referral link may be and still alert.
# A platform that indexes a post late is still worth alerting on, so the second
# value is deliberately larger. Referral codes are de-duplicated in the database,
# so a wider ceiling cannot produce repeat alerts.

# Threads via Scrape Creators keyword search. Each query is one API request per poll.
# Separate extra queries with ||. One query every 5 minutes is the budget baseline.
THREADS_WATCH_INTERVAL_SECONDS=300
THREADS_LOOKBACK_MINUTES=7
THREADS_MAX_POST_AGE_MINUTES=180
# Threads keyword search cannot match a literal URL; keep this keyword-based.
THREADS_QUERIES=claude referral

# Reddit via Scrape Creators search. Each query is one API request per poll.
REDDIT_WATCH_INTERVAL_SECONDS=300
REDDIT_LOOKBACK_MINUTES=7
REDDIT_MAX_POST_AGE_MINUTES=180
# Reddit search does index link targets, so the URL query works here.
REDDIT_QUERIES=claude.ai/referral
REDDIT_SCRAPE_FILTER=posts
REDDIT_SCRAPE_TIMEFRAME=day

# Apify is used for broad public Instagram + Facebook keyword discovery.
# One Actor run is made per configured query per polling cycle.
APIFY_API_TOKEN=
APIFY_TIMEOUT_SECONDS=150
# Hard safety cap passed to each Actor run. The Actor stops/fails rather than charge above this.
APIFY_MAX_RUN_COST_USD=0.10
APIFY_FACEBOOK_ESTIMATED_RUN_COST_USD=0.024
APIFY_INSTAGRAM_ESTIMATED_RUN_COST_USD=0.027
CREDIT_MONITOR_INTERVAL_SECONDS=300
CREDIT_ALERT_THRESHOLDS_HOURS=72,24,6,3,1
APIFY_FACEBOOK_ACTOR_ID=memo23~facebook-search-scraper
APIFY_INSTAGRAM_ACTOR_ID=scraping_solutions~instagram-boolean-search-scraper-posts-reels

# Instagram broad public Posts + Reels search through Apify.
INSTAGRAM_WATCH_INTERVAL_SECONDS=300
INSTAGRAM_LOOKBACK_MINUTES=17
INSTAGRAM_MAX_POST_AGE_MINUTES=360
# The boolean-search Actor matches whole words and rejects URL punctuation.
INSTAGRAM_QUERIES=claude referral
INSTAGRAM_SEARCH_LIMIT=10
INSTAGRAM_CONTENT_TYPE=posts_and_reels
INSTAGRAM_SEARCH_COVERAGE=efficient
INSTAGRAM_HASHTAG_FEED_TYPE=recent

# Facebook broad public post search through Apify.
FACEBOOK_WATCH_INTERVAL_SECONDS=300
FACEBOOK_LOOKBACK_MINUTES=12
FACEBOOK_MAX_POST_AGE_MINUTES=360
# Facebook post search is keyword based; the literal URL returns nothing useful.
FACEBOOK_QUERIES=claude referral
FACEBOOK_SEARCH_LIMIT=10
FACEBOOK_PAGE_DELAY_MS=800

# Telegram Apify-token rotation -> Render environment -> automatic deploy.
# Create a Render API key under Account Settings > API Keys and copy this service's srv-... ID.
RENDER_API_KEY=
RENDER_SERVICE_ID=
APIFY_RENDER_AUTO_DEPLOY=false
# Telegram command (authorized chats only): /set_apify_token apify_api_...
# The running process switches immediately; Render stores the new token and deploys.

# Server-side Claude checks are optional and do not gate Telegram delivery.
# Cloudflare normally blocks hosted browsers, so leave this off in production.
VALIDATOR_BROWSER_FALLBACK_ENABLED=false

# Legacy official Threads API variables. watch-all no longer requires these when
# Scrape Creators is configured; they are kept only for backwards compatibility.
THREADS_ACCESS_TOKEN=
THREADS_SEARCH_LIMIT=50

# X API app-only bearer token.
X_BEARER_TOKEN=
# Recent search is diagnostics/backfill only. Separate multiple queries with ||.
X_QUERIES=url:"claude.ai/referral"
X_SEARCH_LIMIT=100
# Production/live X monitoring. Separate multiple rules with ||.
# Replies containing a referral link are included automatically.
X_STREAM_RULES=url:"claude.ai/referral"
X_STREAM_RECONNECT_SECONDS=5

# YouTube: one OR-style query keeps the URL plus keyword fallbacks in one search.list call.
YOUTUBE_API_KEY=
YOUTUBE_WATCH_INTERVAL_SECONDS=1200
YOUTUBE_LOOKBACK_MINUTES=360
# Quoted OR terms parse far more reliably than a bare slashed URL token.
YOUTUBE_QUERIES="claude referral"|"claude guest pass"|"claude.ai/referral"
YOUTUBE_DAILY_SEARCH_QUOTA=100

EXA_SEARCH_PRICE_USD=0.007

# Direct monitoring avoids waiting for search indexing on known websites.
# Add WordPress/Shopify domains, exact feeds, or sitemaps separated with ||.
WEB_DIRECT_SOURCES=https://example.com||https://another-site.com/feed/
WEB_DIRECT_WATCH_INTERVAL_SECONDS=120
# Sitemap <lastmod> is the page's modification time on a document that is often
# cached for minutes, so a 5-minute window could never see a new post.
WEB_DIRECT_LOOKBACK_MINUTES=120
WEB_DIRECT_TIMEOUT_SECONDS=15
WEB_DIRECT_MAX_PAGES_PER_POLL=50

# Legacy official Reddit OAuth variables. The production watcher now uses Scrape
# Creators; these are kept only for backwards compatibility with older commands/code.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:referral-monitor:v0.6 (by u/YOUR_REDDIT_USERNAME)
REDDIT_SEARCH_LIMIT=100

# Podcast Index + direct RSS monitoring
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
PODCAST_INDEX_USER_AGENT=ReferralMonitor/0.9
PODCAST_INDEX_WATCH_INTERVAL_SECONDS=120
PODCAST_INDEX_RECENT_MAX=1000
PODCAST_LOOKBACK_MINUTES=30
PODCAST_DISCOVERY_INTERVAL_SECONDS=21600
PODCAST_DISCOVERY_QUERIES=claude.ai/referral||Claude||Claude Code
PODCAST_RSS_INTERVAL_SECONDS=120
PODCAST_RSS_MAX_FEEDS=100
PODCAST_SOURCE_REGISTRY=podcast_sources.json
PODCAST_TRANSCRIPT_RETRIES=2
# Repeated failures from one transcript host are logged at most once per 15 minutes.
PODCAST_TRANSCRIPT_FAILURE_LOG_SECONDS=900

# Legacy official Threads OAuth setup (optional; not used by v10.5 watch-all).
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
THREADS_OAUTH_START_KEY=
# Local default: .threads-token.json
# On Render with a persistent disk mounted at /var/data, use:
# THREADS_TOKEN_FILE=/var/data/.threads-token.json
THREADS_TOKEN_FILE=.threads-token.json
# Durable Render storage (recommended on the free plan, whose filesystem is ephemeral).
# Create a Render API key and copy this service's srv-... ID. The app writes only
# THREADS_TOKEN_RECORD, then queues a deploy-only release after OAuth/refresh.
THREADS_RENDER_API_KEY=
THREADS_RENDER_SERVICE_ID=
THREADS_RENDER_ENV_KEY=THREADS_TOKEN_RECORD
THREADS_RENDER_AUTO_DEPLOY=true
# Managed automatically; do not fill this yourself or commit a real value.
THREADS_TOKEN_RECORD=
THREADS_OAUTH_HOST=127.0.0.1
THREADS_OAUTH_PORT=8765
THREADS_OAUTH_SCOPES=threads_basic,threads_keyword_search

# Render automatically provides RENDER_EXTERNAL_URL / RENDER_EXTERNAL_HOSTNAME and PORT.
# THREADS_REDIRECT_URI can stay blank when using the default onrender.com domain.
# Set it explicitly only if you want a custom callback domain.
